# Copie para .env e preencha. O .env nunca vai para o repositório.

# Banco (PostgreSQL 15+ com pg_trgm)
DATABASE_URL=postgresql://vaga_segura:troque-esta-senha@postgres:5432/vaga_segura

# Segredo dos HMAC de telefones, e-mails e chaves PIX (base_contatos e perfis_usuario).
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
# Trocar este valor invalida todos os hashes já gravados.
HMAC_SEGREDO=

