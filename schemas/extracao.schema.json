      "anyOf": [
        {
          "$ref": "#/$defs/Campo_int_"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "salario": {
      "anyOf": [
        {
          "$ref": "#/$defs/Salario"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "local_trabalho": {
      "anyOf": [
        {
          "$ref": "#/$defs/LocalTrabalho"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "beneficios": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Beneficio"
      },
      "title": "Beneficios",
      "type": "array"
    },
    "cobrancas": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Cobranca"
      },
      "title": "Cobrancas",
      "type": "array"
    },
    "descontos": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Desconto"
      },
      "title": "Descontos",
      "type": "array"
    },
    "pagamento": {
      "$ref": "#/$defs/Pagamento",
      "default": {
        "forma": "nao_informado",
        "momento": "nao_informado",
        "duracao_servico_dias": null,
        "trecho": null
      }
    },
    "contrato": {
      "$ref": "#/$defs/Contrato",
      "default": {
        "tipo": "nao_informado",
        "trecho": null,
        "jornada": null
      }
    },
    "contatos": {
      "$ref": "#/$defs/Contatos",
      "default": {
        "telefones": [],
        "emails": [],
        "links": [],
        "chaves_pix": [],
        "canal_exclusivo": "nao_informado",
        "canal_exclusivo_trecho": null
      }
    },
    "sinais_texto": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SinalTexto"
      },
      "title": "Sinais Texto",
      "type": "array"
    }
  },
  "required": [
    "e_oferta_de_trabalho"
  ],
  "title": "ExtracaoOferta",
  "type": "object"
}
